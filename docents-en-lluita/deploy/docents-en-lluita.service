# Servicio de Docents en Lluita. Lo instala deploy/instalar.sh en /etc/systemd/system/.
[Unit]
Description=Docents en Lluita · reserva de moscosos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=docents
Group=docents
WorkingDirectory=/opt/docents-en-lluita
EnvironmentFile=/etc/docents-en-lluita/env
ExecStart=__NODE__ server.js
Restart=on-failure
RestartSec=5

# Endurecimiento: solo puede escribir en su carpeta de datos.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/docents-en-lluita
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
