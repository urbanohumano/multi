# Copia de seguridad diaria de la base de datos (la lanza docents-en-lluita-copia.timer).
[Unit]
Description=Copia de seguridad de Docents en Lluita

[Service]
Type=oneshot
User=docents
Group=docents
WorkingDirectory=/opt/docents-en-lluita
EnvironmentFile=/etc/docents-en-lluita/env
ExecStart=__NODE__ scripts/copia-seguridad.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/docents-en-lluita
UMask=0027
