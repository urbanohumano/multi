# Copia este archivo como .env (o define las variables en tu hosting).

# URL pública (se usa en los enlaces de los correos). Con https:// la cookie de sesión es Secure.
PUBLIC_URL=https://moscosos.example.org
PORT=3000
# En el servidor, escucha solo en local: el tráfico entra por Caddy.
HOST=127.0.0.1
# Detrás de un proxy inverso (nginx, Render, Railway…) para ver la IP real.
TRUST_PROXY=1
DATA_DIR=./data

# Quién puede entrar
ALLOWED_EMAIL_DOMAIN=edu.gva.es
# Correos de la organización (acceden al panel aunque no sean @edu.gva.es)
ADMIN_EMAILS=organitzacio@example.org,persona2@edu.gva.es
CONTACT_EMAIL=organitzacio@example.org

# Jornadas
SEATS_PER_JORNADA=100
# 1 = lunes … 5 = viernes. Empezamos solo con los miércoles: WEEKDAYS=3. Toda la semana: WEEKDAYS=1,2,3,4,5
WEEKDAYS=3
WEEKS_AHEAD=4
# Si a esta hora del día anterior no hay acto publicado, se convoca en la Direcció Territorial
FALLBACK_HOUR=18
DEFAULT_MEETING_TIME=11:00
# Días que se conservan las autorizaciones tras la jornada
RETENTION_DAYS=30
MAX_UPLOAD_MB=5

# Direcciones de las Direcciones Territoriales (opcional, para corregirlas sin tocar código)
# DT_ALACANT=C/ Carratalà, 47, 03007 Alacant
# DT_CASTELLO=Av. del Mar, 23, 12003 Castelló de la Plana
# DT_VALENCIA=C/ Gregorio Gea, 14, 46009 València

# Correo saliente. Sin RESEND_API_KEY ni SMTP_HOST, los correos se guardan en data/outbox/ y salen por consola.
# Resend (recomendado): API key con permiso «Sending access» limitada al dominio del remitente.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_MAX_PER_SECOND=4
MAIL_FROM="Docents en Lluita <moscosos@example.org>"
# Respuestas a los correos (por defecto, CONTACT_EMAIL)
# REPLY_TO=organitzacio@example.org

# Alternativa: cualquier servidor SMTP
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
