# Discourse container definition for 360 Democracy.
# Copy to /var/discourse/containers/app.yml and fill every __PLACEHOLDER__, or let
# install_discourse.sh fill it from environment variables.
# Based on discourse_docker/samples/standalone.yml.

templates:
  - "templates/postgres.template.yml"
  - "templates/redis.template.yml"
  - "templates/web.template.yml"
  - "templates/web.ratelimited.template.yml"
  - "templates/web.ssl.template.yml"
  - "templates/web.letsencrypt.ssl.template.yml"

expose:
  - "80:80"
  - "443:443"

params:
  db_default_text_search_config: "pg_catalog.english"
  # 25 % of RAM is a good start: 2GB on an 8 GB VPS, 1GB on 4 GB.
  db_shared_buffers: "__DB_SHARED_BUFFERS__"
  version: stable

env:
  LC_ALL: en_US.UTF-8
  LANG: en_US.UTF-8
  LANGUAGE: en_US.UTF-8
  # One worker per vCPU, two on a 2-vCPU server.
  UNICORN_WORKERS: __UNICORN_WORKERS__

  DISCOURSE_HOSTNAME: "__HOSTNAME__"
  DISCOURSE_DEVELOPER_EMAILS: "__ADMIN_EMAILS__"

  # European SMTP relay. Brevo: smtp-relay.brevo.com / Scaleway: smtp.tem.scaleway.com
  DISCOURSE_SMTP_ADDRESS: "__SMTP_HOST__"
  DISCOURSE_SMTP_PORT: __SMTP_PORT__
  DISCOURSE_SMTP_USER_NAME: "__SMTP_USER__"
  DISCOURSE_SMTP_PASSWORD: "__SMTP_PASSWORD__"
  DISCOURSE_SMTP_ENABLE_START_TLS: true
  DISCOURSE_SMTP_DOMAIN: "__HOSTNAME__"
  DISCOURSE_NOTIFICATION_EMAIL: "__NOTIFICATION_EMAIL__"

  LETSENCRYPT_ACCOUNT_EMAIL: "__LETSENCRYPT_EMAIL__"

  # Keep uploads and backups local to the container; backups are shipped to S3 by Discourse itself.
  DISCOURSE_MAXMIND_LICENSE_KEY: ""

volumes:
  - volume:
      host: /var/discourse/shared/standalone
      guest: /shared
  - volume:
      host: /var/discourse/shared/standalone/log/var-log
      guest: /var/log

# Chat, events (calendar), reactions and subscriptions ship with Discourse core;
# no extra plugins are cloned here.
hooks:
  after_code:
    - exec:
        cd: $home/plugins
        cmd:
          - git clone --depth 1 https://github.com/discourse/docker_manager.git

run:
  - exec: echo "360 Democracy container built"
